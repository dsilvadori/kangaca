{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "kangaca",
  "compatibility_date": "2026-10-30",
  // O Worker só atende /api/*. Todo o resto são os arquivos estáticos do Astro.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Até 5 pedidos de orçamento por minuto vindos do mesmo IP.
  "ratelimits": [
    {
      "name": "LIMITE_LEADS",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
  // PLANILHA_URL e PLANILHA_TOKEN são secrets: configure no painel do Cloudflare (veja o README).
}
