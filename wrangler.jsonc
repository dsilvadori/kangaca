{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "kangaca",
  "compatibility_date": "2026-10-30",
  // O Worker só atende /api/* e /whatsapp. Todo o resto são os arquivos estáticos do Astro.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/whatsapp", "/whatsapp/"]
  },
  // Até 5 pedidos de orçamento por minuto vindos do mesmo IP.
  "ratelimits": [
    {
      "name": "LIMITE_LEADS",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    // Site key do Turnstile (pública). Vazia = /whatsapp só bloqueia fora do Brasil, sem verificar robô.
    // TURNSTILE_SECRET é secret: configure no painel do Cloudflare (veja o README).
    "TURNSTILE_SITEKEY": ""
  }
  // PLANILHA_URL e PLANILHA_TOKEN são secrets: configure no painel do Cloudflare (veja o README).
}
