---
// Tags do Google com Consent Mode v2. Só entram na página quando há IDs reais em src/config/site.ts.
// O consentimento padrão (negado) é definido antes de qualquer script do Google carregar.
import { TRACKING, trackingAtivo, ga4Ativo, adsAtivo, gtmAtivo } from '../config/site';

const ids = [
  ...(ga4Ativo() ? [TRACKING.GA4_ID] : []),
  // Com o GTM ativo, a tag do Google Ads já vem pelo contêiner: não configurar de novo.
  ...(adsAtivo() && !gtmAtivo() ? [TRACKING.GOOGLE_ADS_ID] : []),
];
---

{
  trackingAtivo() && (
    <>
      <script is:inline define:vars={{ ids }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 500,
        });
        try {
          if (localStorage.getItem('kg-consentimento') === 'granted') {
            gtag('consent', 'update', {
              ad_storage: 'granted',
              ad_user_data: 'granted',
              ad_personalization: 'granted',
              analytics_storage: 'granted',
            });
          }
        } catch (e) {}
        gtag('js', new Date());
        ids.forEach(function (id) { gtag('config', id); });
      </script>
      {ids.length > 0 && (
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ids[0]}`} />
      )}
      {gtmAtivo() && (
        <script is:inline async src={`https://www.googletagmanager.com/gtm.js?id=${TRACKING.GTM_ID}`} />
      )}
    </>
  )
}
