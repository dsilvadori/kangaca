---
import Img from '../Img.astro';
import buffet from '../../assets/instagram-baixa-resolucao/buffet-jardim.jpg';
import mesa from '../../assets/instagram-baixa-resolucao/mesa-evento.jpg';
import sobremesa from '../../assets/instagram-baixa-resolucao/sobremesa-coco.jpg';
import preparo from '../../assets/instagram-baixa-resolucao/preparo-no-balcao-turquesa.jpg';
import salao from '../../assets/instagram-baixa-resolucao/salao-vestido-vermelho.jpg';
import goxinha from '../../assets/pratos/goxinha-close.jpg';
import { INSTAGRAM } from '../../config/site';

const fotos = [
  { src: buffet, alt: 'Buffet servido no jardim, com réchauds e cesta de salgados' },
  { src: sobremesa, alt: 'Sobremesa de manga e coco servida na cumbuca de coco' },
  { src: preparo, alt: 'Cozinheira de lenço colorido preparando um sanduíche diante da porta turquesa' },
  { src: goxinha, alt: 'Close de duas goxinhas douradas com catchup de missô sobre folha de nori' },
  { src: mesa, alt: 'Mesa de evento com finger foods e arranjo de flores secas' },
  { src: salao, alt: 'Mulher de vestido vermelho sentada numa poltrona no salão, com parede turquesa ao fundo' },
];
---

<section class="secao secao--clara instagram" aria-labelledby="instagram-titulo">
  <h2 id="instagram-titulo" data-split>Acompanhe as próximas datas</h2>
  <ul class="instagram__mosaico">
    {fotos.map((f) => <li data-reveal><Img src={f.src} alt={f.alt} sizes="237px" /></li>)}
  </ul>
  <a class="btn btn--contorno btn--escuro" href={INSTAGRAM.url} target="_blank" rel="noopener" data-magnetic>Siga {INSTAGRAM.usuario}</a>
</section>
